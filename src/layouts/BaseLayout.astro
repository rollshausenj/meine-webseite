---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, routes, t, type Lang, type RouteKey } from '../i18n/ui';
import { INDEXING } from '../config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Schlüssel aus routes – sorgt für hreflang und den Sprachumschalter. */
  routeKey: RouteKey;
  /** Seiten ohne Gegenstück in der anderen Sprache (Blogbeiträge): nur diese hreflang-Links ausgeben */
  alternates?: Partial<Record<Lang, string>>;
  /** Bild für Vorschauen in Messengern und sozialen Netzwerken */
  ogImage?: string;
}

const { lang, title, description = t(lang, 'site.description'), routeKey, alternates, ogImage } = Astro.props;
const siteTitle = t(lang, 'site.title');
const fullTitle = title ? `${title} – ${siteTitle}` : `${siteTitle} – ${t(lang, 'site.claim')}`;
const alt: Partial<Record<Lang, string>> = alternates ?? routes[routeKey];
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!INDEXING && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="canonical" href={canonical} />
    {(Object.keys(languages) as Lang[]).filter((l) => alt[l]).map((l) => <link rel="alternate" hreflang={l} href={new URL(alt[l]!, Astro.site)} />)}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_GB'} />
    <meta name="theme-color" content="#0b0b0c" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t(lang, 'nav.skip')}</a>
    <Header lang={lang} current={routeKey} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // Elemente mit data-reveal blenden beim Scrollen weich ein.
      // Alles, was oberhalb der Unterkante liegt, wird gezeigt – auch nach Sprüngen (Anker, Zurück-Taste).
      let pending = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const reveal = () => {
        const limit = window.innerHeight * 0.92;
        pending = pending.filter((el) => {
          if (el.getBoundingClientRect().top < limit) {
            el.classList.add('is-visible');
            return false;
          }
          return true;
        });
        if (!pending.length) window.removeEventListener('scroll', onScroll);
      };
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          reveal();
          ticking = false;
        });
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      window.addEventListener('resize', onScroll, { passive: true });
      reveal();
    </script>
  </body>
</html>
